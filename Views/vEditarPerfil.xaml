<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkIsrael_Octavo.Views.vEditarPerfil"
             Title="vEditarPerfil">

    <ScrollView>
        <VerticalStackLayout
            Spacing="15"
            Padding="15">
            
            <Image
                Source="logo.png"
                MaximumHeightRequest="250"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            </Image>

            <!-- FOTO DE PERFIL -->
            <Frame
                CornerRadius="125"
                HeightRequest="250"
                WidthRequest="250"
                Padding="0"
                HasShadow="True"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Image
                    x:Name="imgPerfil"
                    HeightRequest="250"
                    WidthRequest="250"
                    Aspect="AspectFill">
                </Image>
            </Frame>

            <!-- BOTÓN FOTO -->
            <Button
                x:Name="btnCambImg"
                Text="CAMBIAR FOTO"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="10"
                HeightRequest="45"
                HorizontalOptions="Center"
                BackgroundColor="White"
                BorderColor="#4B2EDB"
                BorderWidth="2"
                TextColor="#4B2EDB"
                Clicked="btnCambImg_Clicked">                
            </Button>

            <!-- FORMULARIO -->
            <Frame
                Padding="20"
                CornerRadius="15"
                HasShadow="True"
                BorderColor="#DDDDDD"
                BackgroundColor="White">

                <Grid
                    RowSpacing="10"
                    ColumnSpacing="10">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ID SOLO LECTURA -->
                    <Label Grid.Row="0" Grid.Column="0" Text="ID:" FontAttributes="Bold"/>
                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Id}" IsReadOnly="True" TextColor="Gray"/>

                    <!-- STATUS -->
                    <Label Grid.Row="0" Grid.Column="2" Text="Status:" FontAttributes="Bold"/>
                    <Entry Grid.Row="0" Grid.Column="3" Text="{Binding Status}" IsReadOnly="True" TextColor="Gray"/>

                    <!-- APELLIDOS -->
                    <Label Grid.Row="1" Grid.Column="0" Text="Apellidos:" FontAttributes="Bold"/>
                    <Entry Grid.Row="1" Grid.Column="1" x:Name="txtApellidos" Text="{Binding Apellidos}" Placeholder="Apellidos" />

                    <!-- NOMBRES -->
                    <Label Grid.Row="1" Grid.Column="2" Text="Nombres:" FontAttributes="Bold"/>
                    <Entry Grid.Row="1" Grid.Column="3" x:Name="txtNombres" Text="{Binding Nombres}" Placeholder="Nombres" />

                    <!-- CÉDULA -->
                    <Label Grid.Row="2" Grid.Column="0" Text="Cédula:" FontAttributes="Bold"/>
                    <Entry Grid.Row="2" Grid.Column="1" x:Name="txtCedula" Text="{Binding Cedula}" Keyboard="Numeric" MaxLength="10" Placeholder="0000000000" />

                    <!-- ACTIVO -->
                    <Label Grid.Row="2" Grid.Column="2" Text="Activo:" FontAttributes="Bold"/> 
                    <Entry Grid.Row="2" Grid.Column="3" Text="{Binding Activo}" IsReadOnly="True" TextColor="Gray"/>

                    <!-- CORREO -->
                    <Label Grid.Row="3" Grid.Column="0" Text="Correo:" FontAttributes="Bold"/>
                    <Entry Grid.Row="3" Grid.Column="1" x:Name="txtCorreo" Text="{Binding Correo}" Keyboard="Email" Placeholder="correo@ejemplo.com" />

                    <!-- TELÉFONO -->
                    <Label Grid.Row="3" Grid.Column="2" Text="Teléfono:" FontAttributes="Bold"/>
                    <Entry Grid.Row="3" Grid.Column="3" x:Name="txtTelefono" Text="{Binding Telefono}" Keyboard="Telephone" Placeholder="0999999999" />

                    <!-- VEHÍCULO -->
                    <Label Grid.Row="4" Grid.Column="0" Text="Vehículo:" FontAttributes="Bold"/>
                    <Picker Grid.Row="4" Grid.Column="1" x:Name="pkTipoVehiculo" SelectedItem="{Binding TipoVehiculo}">
                        <Picker.Items>
                            <x:String>Auto</x:String>
                            <x:String>Moto</x:String>
                        </Picker.Items>
                    </Picker>

                    <!-- PLACA -->
                    <Label Grid.Row="4" Grid.Column="2" Text="Placa:" FontAttributes="Bold"/>
                    <Entry Grid.Row="4" Grid.Column="3" x:Name="txtPlaca" Text="{Binding PlacaVehicular}" Placeholder="ABC1234" />

                    <!-- USUARIO -->
                    <Label Grid.Row="5" Grid.Column="0" Text="Usuario:" FontAttributes="Bold"/>
                    <Entry Grid.Row="5" Grid.Column="1" x:Name="txtUsuario" Text="{Binding Usuario}" Placeholder="Usuario" />

                    <!-- CONTRASEÑA -->
                    <Label Grid.Row="5" Grid.Column="2" Text="Contraseña:" FontAttributes="Bold"/>
                    <Entry Grid.Row="5" Grid.Column="3" x:Name="txtContrasena" Text="{Binding Contrasena}" Placeholder="********" />

                </Grid>

            </Frame>

            <!-- ACTUALIZAR -->
            <Button
                x:Name="btnActualizar"
                Text="ACTUALIZAR MIS DATOS"
                FontSize="20"
                BackgroundColor="DarkOrange"
                TextColor="White"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="45"
                Clicked="btnActualizar_Clicked">                
            </Button>

            <Image
                Source="uisrael.jpg"
                MaximumHeightRequest="55">                
            </Image>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>