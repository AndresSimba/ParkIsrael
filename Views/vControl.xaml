<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkIsrael_Octavo.Views.vControl"
             Title="vControl">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="30">

            <Image
                Source="logo.png"
                MaximumHeightRequest="250"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            </Image>

            <Label Text="CONTROL DE PARQUEADEROS"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center">                
            </Label>

            <Grid
                RowSpacing="10"
                ColumnSpacing="10">
                
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!--SEDE MATRIZ-->
                <Label
                    Grid.Row="0" Grid.Column="0"
                    Text="SEDE MATRIZ"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">                    
                </Label>

                <Frame
                    Grid.Row="1" Grid.Column="0"
                    BackgroundColor="#2E86C1"
                    CornerRadius="15"
                    HasShadow="True"
                    Padding="10"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">

                    <Label
                        x:Name="lblMatriz"
                        Text="20"
                        TextColor="WhiteSmoke"
                        FontSize="45"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center">                        
                    </Label>
                </Frame>

                <!--SEDE ESCUELA DE IDIOMAS-->
                <Label
                    Grid.Row="0" Grid.Column="1"
                    Text="ESCUELA DE IDIOMAS"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">                    
                </Label>

                <Frame
                    Grid.Row="1" Grid.Column="1"
                    BackgroundColor="#27AE60"
                    CornerRadius="15"
                    HasShadow="True"
                    Padding="10"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">

                    <Label
                        x:Name="lblIdiomas"
                        Text="20"
                        TextColor="WhiteSmoke"
                        FontSize="45"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center">                        
                    </Label>
                </Frame>


                <!--SEDE ESCUELA DE POSGRADOS-->
                <Label
                    Grid.Row="0" Grid.Column="2"
                    Text="ESCUELA DE POSGRADOS"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">                    
                </Label>

                <Frame
                    Grid.Row="1" Grid.Column="2"
                    BackgroundColor="#D35400"
                    CornerRadius="15"
                    HasShadow="True"
                    Padding="10"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">

                    <Label
                        x:Name="lblPosgrado"
                        Text="20"
                        TextColor="WhiteSmoke"
                        FontSize="45"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center">                        
                    </Label>
                </Frame>

            </Grid>
            
            <!-- SELECTOR DE SEDE -->
            <Label Text="SELECCIONAR SEDE:" FontSize="20" FontAttributes="Bold"/>
            <Picker
                x:Name="pkSede"
                FontSize="20"
                SelectedIndexChanged="pkSede_SelectedIndexChanged">
                <Picker.Items>
                    <x:String>MATRIZ</x:String>
                    <x:String>IDIOMAS</x:String>
                    <x:String>POSGRADOS</x:String>
                </Picker.Items>                
            </Picker>

            <HorizontalStackLayout
                Spacing="30"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,40">

                <Button
                    x:Name="btnSalida"
                    Text="SALIR"
                    FontSize="20"
                    FontAttributes="Bold"
                    BackgroundColor="#C0392B"
                    TextColor="White"
                    CornerRadius="10"
                    WidthRequest="140"
                    HeightRequest="50"
                    IsEnabled="False"
                    Clicked="btnSalida_Clicked">                    
                </Button>

                <Button
                    x:Name="btnEntrada"
                    Text="ENTRAR"
                    FontSize="20"
                    FontAttributes="Bold"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    CornerRadius="10"
                    WidthRequest="140"
                    HeightRequest="50"
                    IsEnabled="False"
                    Clicked="btnEntrada_Clicked">                    
                </Button>

            </HorizontalStackLayout>

            <VerticalStackLayout
                Padding="15"
                Spacing="15">
                
                <Button
                    x:Name="btnReiniciar"
                    Text="REINICIAR"
                    FontAttributes="Bold"
                    FontSize="20"
                    CornerRadius="10"
                    HeightRequest="45"
                    Clicked="btnReiniciar_Clicked">                    
                </Button>

                <Button
                    x:Name="btnPantalla"
                    Text="MOSTRAR PANTALLA"
                    FontSize="20"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="45"
                    Clicked="btnPantalla_Clicked">                    
                </Button>

                <Button
                    x:Name="btnEscanearQR"
                    Text="ESCANEAR QR"
                    FontSize="20"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="45"
                    Clicked="btnEscanearQR_Clicked">                    
                </Button>

            </VerticalStackLayout>
            
            <Image
                Source="uisrael.jpg"
                MaximumHeightRequest="55">
            </Image>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
