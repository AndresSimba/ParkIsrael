<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkIsrael_Octavo.Views.vPantalla"
             Title="">

    <Grid Padding="20"
          RowDefinitions="Auto,*">

        <Label x:Name="lblTitulo"
               Grid.Row="0"
               Text="SEDE"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,20,0,20">            
        </Label>

        <Frame x:Name="frmContenedor"
               Grid.Row="1"
               BackgroundColor="Gray"
               CornerRadius="30"
               Padding="20"
               HorizontalOptions="Center"
               VerticalOptions="Center">

            <Label x:Name="lblCupos"
                   Text="0"
                   TextColor="White"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">                
            </Label>
        </Frame>

    </Grid>
</ContentPage>